MONGO_URI=mongodb://127.0.0.1:27017/tcgplayer

# REQUIRED. Must be at least 32 characters.
JWT_SECRET=""

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# Email — leave SMTP_USER/SMTP_PASS empty or set EMAIL_MOCK_MODE=true to log emails instead of sending.
EMAIL_MOCK_MODE=true
SMTP_USER=""
SMTP_PASS=""

# Optional: dev-only seed admin (only runs when both are set AND ASPNETCORE_ENVIRONMENT=Development).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
